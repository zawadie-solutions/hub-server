<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Activate your account — Zawadie AI Hub' }) %>
</head>
<body class="login-body">

  <div class="login-shell">
    <main class="login-form-panel">
      <div class="login-form-card">
        <div class="login-brandmark">
          <img src="/images/zawadie-logo.png" alt="" />
          <span>Zawadie AI Hub</span>
        </div>
        <h2>Activate your account</h2>
        <% if (email) { %>
        <p class="login-sub">Welcome, <%= email %>. Choose a password to finish setting up your account.</p>
        <% } %>

        <% if (error) { %>
        <div class="form-error"><%= error %></div>
        <% } %>

        <% if (token) { %>
        <form method="POST" action="/invite/<%= token %>" class="form" novalidate>
          <%# The email box tells browsers and phones which account this new password is for, so they save it under the right email. The server ignores it. %>
          <label class="field">
            <span>Work email</span>
            <input class="input" type="email" name="username" value="<%= email %>" autocomplete="username" readonly />
          </label>
          <label class="field">
            <span>Password</span>
            <span class="password-wrap">
              <input class="input" type="password" name="password" minlength="8" placeholder="At least 8 characters" autocomplete="new-password" required autofocus />
              <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false" hidden>Show</button>
            </span>
            <span class="password-hint" role="status" hidden>Caps Lock is on.</span>
          </label>
          <label class="field">
            <span>Confirm password</span>
            <span class="password-wrap">
              <input class="input" type="password" name="confirm" minlength="8" autocomplete="new-password" required />
              <button type="button" class="password-toggle" aria-label="Show password" aria-pressed="false" hidden>Show</button>
            </span>
            <span class="password-hint" role="status" hidden>Caps Lock is on.</span>
          </label>
          <button class="btn btn-primary btn-block" type="submit">Activate account</button>
        </form>
        <% } else { %>
        <a class="btn btn-primary btn-block" href="/login">Back to sign in</a>
        <% } %>
      </div>
    </main>
  </div>

  <script src="/js/password.js"></script>
</body>
</html>
