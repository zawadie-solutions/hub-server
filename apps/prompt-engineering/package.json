{
  "name": "prompt-engineering",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file=.env --import tsx scripts/dev-server.ts",
    "dev:local": "concurrently -n vite,api -c blue,green \"npm:dev\" \"npm:dev:api\"",
    "dev:full": "vercel dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.27",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "pg": "^8.22.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vercel": "^57.0.0",
    "vite": "^8.1.1"
  }
}
