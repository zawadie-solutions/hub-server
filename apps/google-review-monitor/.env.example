# Copy to .env and fill in. Never commit .env.

# --- Database (MySQL 8) ---
# URL-encode special characters in the password (# -> %23, @ -> %40).
DATABASE_URL=mysql://user:password@localhost:3306/google_review_monitor
# Only for `npm test`: a MySQL server where the tests may create and drop their own databases.
TEST_DATABASE_URL=

# --- Asana ---
ASANA_TOKEN=
ASANA_PROJECT_GID=
# Path of names from the project root to a review task is [section, task, subtask, ...].
# Month/location are taken from this path. Run `npm run discover` to see the real structure.
ASANA_MONTH_INDEX=0
ASANA_LOCATION_INDEX=1
ASANA_MAX_DEPTH=3
ASANA_INCLUDE_COMPLETED=true
# Use the task title as reviewer name when the description has no "Reviewer: ..." line
ASANA_REVIEWER_FROM_TITLE=false

# --- Google Business Profile API (OAuth, account that manages the locations) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# JSON map of Asana location name -> "accounts/123/locations/456" (see config/locations.example.json)
GBP_LOCATIONS_FILE=config/locations.json

# --- Which Google source checks reviews: business-profile (default), places, apify or dataforseo ---
REVIEW_CHECKER=business-profile
# Optional second source (same names), asked only when the first one fails outright, e.g. it
# is out of credit or unreachable. Not used when the first source answered "could not be checked".
REVIEW_CHECKER_FALLBACK=
# Places API (New) key, used when REVIEW_CHECKER=places. Places returns at most 5 reviews per
# place, so a review it does not return is UNKNOWN unless the place has no more than that.
GOOGLE_PLACES_API_KEY=
# Apify API token, used when REVIEW_CHECKER=apify (actor compass/google-maps-reviews-scraper).
# Billed per review scraped.
APIFY_TOKEN=
# DataForSEO API login + password (https://app.dataforseo.com/api-access), used when
# REVIEW_CHECKER=dataforseo (Business Data API -> Google Reviews). Billed per 10 reviews.
# DATAFORSEO_PRIORITY=true uses the priority queue (about a minute, double the price) for
# full runs too; single-location checks from the dashboard always use it.
# How many Google reviews are looked through per location is set on the dashboard
# (Run options / Configure), not here.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_PRIORITY=false

# REVIEW_CHECKER=scrape (testing): opens each review link in headless Chrome and looks for
# Google's "This review is no longer available." Where Chrome can't run (Hostinger), set the
# scraper API deployed on Vercel (scraper-api/README.md); otherwise a local Chrome/Edge is used.
SCRAPE_API_URL=
SCRAPE_API_SECRET=
# SCRAPE_BROWSER_PATH=   (only to point at a specific local Chrome/Edge)

# --- Notification: Slack DM (used instead of email when SLACK_BOT_TOKEN is set) ---
# Bot token from a Slack app with the chat:write scope, installed to the workspace.
SLACK_BOT_TOKEN=
# Slack member ID(s) to DM (profile -> "..." -> Copy member ID, not name/email). Comma-separated for several.
SLACK_RECIPIENT_USER_ID=

# --- Notification: Email (SMTP) — fallback when SLACK_BOT_TOKEN is not set ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Vanessa's address (comma-separated for several)
NOTIFY_TO=

# --- Scheduling / behaviour ---
# Daily 07:00 CAT (Africa/Maputo, UTC+2)
SCHEDULE_CRON=0 7 * * *
# Wait before re-checking a "removed" result; removal is only accepted if both checks agree
REMOVAL_RECHECK_DELAY_MS=60000
CHECK_DELAY_MS=500
# Keep checking reviews after Vanessa was notified (to detect reappearance)
KEEP_CHECKING_REMOVED=false

LOG_LEVEL=info

# --- Dashboard (sign-in form: this username and password) ---
PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
