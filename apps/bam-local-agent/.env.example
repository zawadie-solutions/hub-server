PORT=3000
NODE_ENV=production

DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional: model used for the automatic local research (defaults to OPENAI_CHAT_MODEL). Web search is used when the account allows it.
# OPENAI_RESEARCH_MODEL=gpt-4o-mini
# Re-research stores automatically when a newer playbook goes live. Set to off to disable.
# AUTO_RESEARCH_REFRESH=on
# Local research runs from the hPanel cron job (scripts/runResearch.js, see README). In development the web app runs it for you;
# set RESEARCH_IN_PROCESS=on to do the same elsewhere. Leave it off in production.
# RESEARCH_IN_PROCESS=off
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Shared secret for /api/admin/* routes (send as x-admin-key header)
ADMIN_API_KEY=

# Shared access code for the marketing planner page (/ask). Different from ADMIN_API_KEY.
TEAM_ACCESS_KEY=

# Zawadie Hub single sign-on. Same value as ZAWADIE_SSO_SECRET in the hub (hub-server/data/sso-secret.txt if the hub generated one).
# With it set, people signed in to the hub who have this project don't need the keys above.
ZAWADIE_SSO_SECRET=
