PORT=3000

# Required — Ombeni AI's chat + meeting analysis run on this.
OPENAI_API_KEY=

# Optional for now — leave blank until you embed the real Monday.com API.
# Ombeni AI will still run and show tasks as "Pending Monday.com sync".
MONDAY_API_KEY=
MONDAY_BOARD_ID=

# Optional for now — leave blank until you embed the real Slack app/bot.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Google Sign-In — restricts login to your Google Workspace domain and lets
# meeting content be scoped to actual participants. Leave blank to disable
# login (the app then runs fully open, no per-meeting access control).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Only Google accounts on this domain may sign in. Defaults to zawadie.com if unset.
GOOGLE_ALLOWED_DOMAIN=zawadie.com
SESSION_SECRET=

# Shared with the Zawadie Hub (hub-server/data/sso-secret.txt) so this app
# trusts the hub's login instead of running its own. Must match exactly —
# copy the value hub-server generates on first run.
ZAWADIE_SSO_SECRET=
