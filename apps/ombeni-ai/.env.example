PORT=3000

# Required — Ombeni AI's chat + meeting analysis run on this.
OPENAI_API_KEY=

# Optional for now — leave blank until you embed the real Monday.com API.
# Ombeni AI will still run and show tasks as "Pending Monday.com sync".
MONDAY_API_KEY=
MONDAY_BOARD_ID=

# Optional for now — leave blank until you embed the real Slack app/bot.
# Success statements are sent as DMs with SLACK_BOT_TOKEN; the Slack app needs
# the chat:write and users:read.email permissions for that.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Success statements (My Work). All optional.
# Attendees on these domains are Zawadie people; anyone else makes it a client meeting.
# Full addresses work too, for people who work with Zawadie on a personal email.
COMPANY_DOMAINS=zawadie.com
# Where "Open in Ombeni" links in Slack point.
APP_URL=https://ai.zawadie.com/ombeni-ai/
# Write statements for meetings on/after this date (YYYY-MM-DD). Blank: from the day it first runs.
STATEMENTS_FROM=
# "off" writes statements without sending Slack DMs (local testing).
SEND_SLACK_DMS=

# Google Sign-In — restricts login to your Google Workspace domain and lets
# meeting content be scoped to actual participants. Leave blank to disable
# login (the app then runs fully open, no per-meeting access control).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Only Google accounts on this domain may sign in. Defaults to zawadie.com if unset.
GOOGLE_ALLOWED_DOMAIN=zawadie.com
SESSION_SECRET=

# Shared with the Zawadie Hub (hub-server/data/sso-secret.txt) so this app
# trusts the hub's login instead of running its own. Must match exactly —
# copy the value hub-server generates on first run.
ZAWADIE_SSO_SECRET=

# Co-worker (morning messages, meeting prep, Gmail drafts). Optional.
# Encrypts each person's stored Google access. Inside the hub set OMBENI_TOKEN_KEY
# to a long random value and never change it (changing it means everyone reconnects Google).
TOKEN_KEY=
# "off" stops morning messages and meeting prep notes.
COWORKER=
