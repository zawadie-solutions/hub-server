{
  "name": "zawadie-ai-hub-router",
  "version": "2.0.0",
  "private": true,
  "description": "Login-gated Zawadie Solutions Hub: serves the hub + admin UI, runs built-in solutions (apps/) in-process, and reverse-proxies the rest to their running apps.",
  "main": "server.js",
  "scripts": {
    "start": "tsx server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p apps/google-review-monitor && tsc --noEmit -p apps/company-research",
    "company-research:import-python": "tsx apps/company-research/scripts/importFromPython.ts",
    "company-research:build-ui": "npm --prefix apps/company-research/frontend install && npm --prefix apps/company-research/frontend run build",
    "monitor:migrate": "tsx apps/google-review-monitor/src/cli/migrate.ts",
    "monitor:discover": "tsx apps/google-review-monitor/src/cli/discover.ts",
    "monitor:check-month": "tsx apps/google-review-monitor/src/cli/checkMonth.ts",
    "monitor:run-once": "tsx apps/google-review-monitor/src/cli/runOnce.ts",
    "monitor:preview": "tsx apps/google-review-monitor/src/cli/preview.ts",
    "monitor:poc": "tsx apps/google-review-monitor/src/cli/poc.ts",
    "monitor:scrape-check": "tsx apps/google-review-monitor/src/cli/scrapeCheck.ts",
    "monitor:scrape-pilot": "tsx apps/google-review-monitor/src/cli/scrapePilot.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-session": "^1.18.1",
    "google-auth-library": "^11.3.1",
    "htmlparser2": "^9.1.0",
    "http-proxy-middleware": "^3.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "onnxruntime-node": "^1.30.0",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.4",
    "pino": "^9.3.2",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "tsx": "^4.17.0",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
